# Cloudflare Pages headers. The service worker and the HTML must never be served stale,
# otherwise installed copies of the game would not pick up new deploys.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
/assets/*
  Cache-Control: public, max-age=31536000, immutable
